# ==============================================================================
# SCHEDULA ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# For Vercel Deployment: Configure these in Project Settings -> Environment Variables.
# NEVER commit real private keys or service account JSON to public GitHub repositories.

# --- Firebase Client SDK (Public Web Credentials) ---
NEXT_PUBLIC_FIREBASE_API_KEY="your-firebase-api-key"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your-app.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your-firebase-project-id"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="your-app.firebasestorage.app"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="your-messaging-sender-id"
NEXT_PUBLIC_FIREBASE_APP_ID="your-web-app-id"

# --- Firebase Admin SDK (Server-Side Operations & Privilege Management) ---
# Option 1: Individual Service Account Credentials (Recommended for Vercel)
FIREBASE_PROJECT_ID="your-firebase-project-id"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@your-app.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# Option 2: Full Service Account JSON String (Alternative)
# FIREBASE_SERVICE_ACCOUNT='{"type":"service_account","project_id":"...","private_key_id":"...","private_key":"...","client_email":"..."}'

# --- Optional AI Integrations ---
# GEMINI_API_KEY="your-gemini-api-key"
